# ============================================================================
#  Rivaldo Imóveis — regras básicas (Apache / LiteSpeed em hospedagem compartilhada)
#  Tudo protegido por <IfModule> para não gerar erro 500 se um módulo faltar.
# ============================================================================

# Sem listagem de diretórios
Options -Indexes

DirectoryIndex index.html index.php

# Arquivos que nunca devem ser baixados pela web
<FilesMatch "(^\.|\.(sql|md|log|ini|bak|old|swp|sh|lock|dist|zip|tar|gz|yml|yaml|bat|cmd)$|^composer\.(json|lock)$|^Dockerfile$|\.example\.php$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "geolocation=(), microphone=(), payment=()"
</IfModule>

# Cache: as páginas sempre são conferidas no servidor; elas apontam para CSS/JS/imagens
# com versão no endereço (?v=..., gerada pelo scripts/publicar.py), então arquivo novo
# = endereço novo e não é preciso limpar o cache da CDN.
<IfModule mod_headers.c>
    <FilesMatch "\.html?$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

# Tipos corretos para o PWA do painel
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    AddType image/webp .webp
</IfModule>

# ----------------------------------------------------------------------------
# HTTPS obrigatório — DESCOMENTE depois que o SSL (Let's Encrypt/AutoSSL)
# estiver ativo na hospedagem:
#
# <IfModule mod_rewrite.c>
#     RewriteEngine On
#     RewriteCond %{HTTPS} !=on
#     RewriteCond %{HTTP:X-Forwarded-Proto} !https
#     RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>
#
# <IfModule mod_headers.c>
#     Header always set Strict-Transport-Security "max-age=31536000"
# </IfModule>
# ----------------------------------------------------------------------------
